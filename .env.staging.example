# Staging environment overrides
# Copy this to .env on the staging server and fill in the real values.
# All other vars inherit from .env.example defaults.

NODE_ENV=staging
PORT=4400
HOST=0.0.0.0

# --- Database ---
# Point to a separate Atlas database for staging.
# Either a different DB name on the same cluster, or a separate cluster entirely.
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/oj-multimedia-staging

# --- R2 Storage ---
# Credentials are identical to prod (same bucket, same account).
# Only the folder prefix changes — staging files live under a different prefix.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_FOLDER_PREFIX=staging-files
R2_CDN_URL=
R2_PUBLIC_URL=

# --- Secrets (must be different from prod) ---
JWT_SECRET=
REFRESH_TOKEN_SECRET=
COOKIE_SECRET=

# --- CORS / App URLs (staging hostnames) ---
CORS_ORIGIN=https://staging.ojmultimedia.com,https://admin-staging.ojmultimedia.com
ADMIN_APP_URL=https://admin-staging.ojmultimedia.com
CLIENT_APP_URL=https://staging.ojmultimedia.com
FRONTEND_REVALIDATION_URL=https://staging.ojmultimedia.com/api/revalidate
REVALIDATION_SECRET=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Logging (verbose in staging) ---
LOG_FORMAT=pretty
LOG_PRETTY=1
LOG_LEVEL=debug
ENABLE_METRICS_ROUTE=1

# --- Auth ---
# Staging enforces refresh tokens the same as prod
REQUIRE_REFRESH_TOKEN=true

# --- Google OAuth (can share prod credentials or use separate staging OAuth app) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- YouTube ---
YOUTUBE_API_KEY=

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ojmultimedia.com
EMAIL_FROM_NAME=OJ Multimedia (Staging)

# --- Branding ---
APP_NAME=OJ Multimedia (Staging)
SUPPORT_EMAIL=ohemultimedia@gmail.com
