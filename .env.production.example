# Production environment — oj-backend on Coolify.
# Copy this to .env on the production server and fill in the real values.

NODE_ENV=production
PORT=4400
HOST=0.0.0.0

# --- Database (self-hosted MongoDB on Coolify) ---
# If oj-backend is on the same Coolify Docker network as the mongodb-stack,
# use the service hostname directly with directConnection=true (avoids RS
# member-list hostname resolution issues with single-node replica sets).
DATABASE_URL=mongodb://APP_USER:APP_PASSWORD@mongodb:27017/oj-multimedia?directConnection=true&authSource=oj-multimedia
#
# If oj-backend is on a DIFFERENT Coolify stack/network (e.g. OJM DB Essentials on "stack
# network only" and OJ Backend on the shared coolify network), use the Docker host gateway IP.
# From inside the OJ Backend container: gateway = 10.0.1.1 (read from /proc/net/route).
# MongoDB port 27017 is published on the host (ports: "27017:27017"), so this reaches it.
# DATABASE_URL=mongodb://APP_USER:APP_PASSWORD@10.0.1.1:27017/oj-multimedia?directConnection=true&authSource=oj-multimedia

# --- R2 Storage ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_FOLDER_PREFIX=production-files
R2_CDN_URL=
R2_PUBLIC_URL=

# --- Secrets (all required in production, min 32 chars, no placeholders) ---
JWT_SECRET=
REFRESH_TOKEN_SECRET=
COOKIE_SECRET=

# --- CORS / App URLs ---
CORS_ORIGIN=https://ojmultimedia.com,https://admin.ojmultimedia.com
ADMIN_APP_URL=https://admin.ojmultimedia.com
CLIENT_APP_URL=https://ojmultimedia.com
FRONTEND_REVALIDATION_URL=https://ojmultimedia.com/api/revalidate
REVALIDATION_SECRET=

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
REQUIRE_REFRESH_TOKEN=true

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- YouTube ---
YOUTUBE_API_KEY=

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ojmultimedia.com
EMAIL_FROM_NAME=OJ Multimedia

# --- Branding ---
APP_NAME=OJ Multimedia
SUPPORT_EMAIL=ohemultimedia@gmail.com

# --- Logging (lean in production) ---
LOG_FORMAT=json
LOG_PRETTY=0
LOG_LEVEL=info
ENABLE_METRICS_ROUTE=0
